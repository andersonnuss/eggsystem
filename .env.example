# Copie para .env e ajuste os valores
PORT=3000
# Caminho do arquivo do banco SQLite
DB_PATH=./data/eggsystem.db
# Troque por um texto longo e aleatório (ex.: saída de: openssl rand -hex 32)
SESSION_SECRET=troque-isto-por-um-segredo-longo
# Defina como true quando estiver atrás de HTTPS (nginx/caddy)
COOKIE_SECURE=false

# Alexa (opcional). Sem ALEXA_SKILL_ID o endpoint /alexa fica desligado.
# Skill ID: Alexa Developer Console -> sua skill -> "Copy Skill ID"
ALEXA_SKILL_ID=
# Nome que você fala: "Alexa, diga ao meu sítio que..." (tem que ser igual ao da skill)
ALEXA_INVOCACAO=meu sítio
