<%- include('../partials/topo') %>
<h1>Produção</h1>
<div class="cartao">
  <% if (erro) { %><div class="erro"><%= erro %></div><% } %>
  <% if (!produtos.length) { %>
    <p>Cadastre um produto primeiro. <a href="/produtos/novo">Novo produto</a></p>
  <% } else { %>
  <form method="post" action="/producao" class="formulario">
    <div class="linha">
      <label>Tipo
        <select name="tipo">
          <option value="producao" <%= form.tipo === 'producao' ? 'selected' : '' %>>Produção</option>
          <option value="perda" <%= form.tipo === 'perda' ? 'selected' : '' %>>Perda/consumo</option>
        </select>
      </label>
      <label>Data <input type="date" name="data" value="<%= form.data %>" required></label>
    </div>
    <label>Produto
      <select name="produto_id" id="produto" required>
        <option value="">Escolha…</option>
        <% for (const p of produtos) { %>
          <option value="<%= p.id %>" data-unidade="<%= u.unidadeProducao(p) %>" <%= p.id === form.produto_id ? 'selected' : '' %>><%= p.nome %> (em <%= u.unidadeProducao(p) %>)</option>
        <% } %>
      </select>
    </label>
    <div class="linha">
      <label><span>Quantidade <span id="unidade-qtd"></span></span>
        <input name="quantidade" inputmode="decimal" value="<%= form.quantidade %>" required autofocus>
      </label>
      <label>Observação <input name="observacao" value="<%= form.observacao || '' %>" placeholder="opcional"></label>
    </div>
    <button class="botao">Registrar</button>
  </form>
  <script>
    (function () {
      const sel = document.getElementById('produto');
      const rotulo = document.getElementById('unidade-qtd');
      const atualizar = () => {
        const un = sel.selectedOptions[0]?.dataset.unidade;
        rotulo.textContent = un ? '(' + un + ')' : '';
      };
      sel.addEventListener('change', atualizar);
      atualizar();
    })();
  </script>
  <% } %>
</div>

<h2>Últimos registros</h2>
<% if (!registros.length) { %><p class="vazio">Nenhum registro ainda.</p><% } %>
<ul class="lista">
  <% for (const r of registros) { %>
    <li>
      <div class="bloco">
        <div class="titulo"><a href="/produtos/<%= r.produto_id %>/extrato"><%= r.produto %></a><%= r.tipo === 'ajuste' ? ' · ajuste por contagem' : '' %></div>
        <div class="sutil"><%= u.data(r.data) %><%= r.observacao ? ' · ' + r.observacao : '' %></div>
      </div>
      <div class="valor">
        <% const negativo = r.tipo === 'perda' || r.quantidade < 0; %>
        <div><%= negativo ? '−' : '+' %><%= u.numero(Math.abs(r.quantidade)) %> <%= r.unidade %></div>
        <form method="post" action="/producao/<%= r.id %>/excluir" class="inline" onsubmit="return confirm('Excluir este registro?')">
          <button class="link sutil">excluir</button>
        </form>
      </div>
    </li>
  <% } %>
</ul>
<%- include('../partials/rodape') %>
