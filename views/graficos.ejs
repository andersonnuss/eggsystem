<%- include('partials/topo') %>
<h1>Gráfico de produção</h1>

<% if (!produto) { %>
  <p class="vazio">Cadastre um produto para ver o gráfico. <a href="/produtos/novo">Novo produto</a></p>
<% } else {
     const nomeGrao = { dia: 'dia', semana: 'semana', mes: 'mês' }[grao];
     const link = (p) => `/graficos?${new URLSearchParams({ produto: produto.id, periodo: p })}`; %>

  <form method="get" action="/graficos" class="filtros-grafico">
    <input type="hidden" name="periodo" value="<%= periodo %>">
    <select name="produto" onchange="this.form.submit()" aria-label="Produto">
      <% for (const p of produtos) { %>
        <option value="<%= p.id %>" <%= p.id === produto.id ? 'selected' : '' %>><%= p.nome %></option>
      <% } %>
    </select>
    <div class="filtros" role="group" aria-label="Período">
      <% for (const [chave, p] of Object.entries(periodos)) { %>
        <a href="<%= link(chave) %>" class="<%= chave === periodo ? 'ativo' : '' %>" <%= chave === periodo ? 'aria-current="true"' : '' %>><%= p.nome %></a>
      <% } %>
    </div>
  </form>

  <div class="numeros numeros-3">
    <div class="numero"><div class="rotulo">Total em <%= periodos[periodo].nome %></div><div class="valor"><%= qtd(total) %></div></div>
    <div class="numero"><div class="rotulo">Média por dia</div><div class="valor"><%= qtd(mediaDia) %></div></div>
    <div class="numero"><div class="rotulo">Melhor <%= nomeGrao %></div>
      <div class="valor"><%= melhor ? qtd(melhor.valor) : '—' %></div>
      <% if (melhor) { %><div class="sutil"><%= melhor.detalhe %></div><% } %>
    </div>
  </div>

  <div class="cartao grafico-cartao">
    <div class="sutil grafico-titulo">
      <%= produto.nome %>: produção por <%= nomeGrao %>, em <%= u.unidadeProducao(produto) === 'ovo' ? 'ovos' : unidade %>
    </div>
    <% if (total === 0) { %>
      <p class="vazio">Nenhuma produção lançada neste período.</p>
    <% } else { %>
      <div id="grafico" class="grafico" role="img"
           aria-label="<%= `Produção de ${produto.nome} por ${nomeGrao}, total ${qtd(total)}` %>"></div>
      <div class="acoes grafico-acoes">
        <button type="button" id="compartilhar" class="botao secundario">📤 Compartilhar</button>
        <span id="compartilhar-aviso" class="sutil" role="status"></span>
      </div>
    <% } %>
  </div>

  <details class="cartao">
    <summary>Ver tabela</summary>
    <table class="tabela">
      <thead><tr><th><%= nomeGrao[0].toUpperCase() + nomeGrao.slice(1) %></th><th class="direita">Produção</th></tr></thead>
      <tbody>
        <% for (const b of baldes.slice().reverse()) { %>
          <tr><td><%= b.detalhe %></td><td class="direita"><%= b.texto %></td></tr>
        <% } %>
      </tbody>
    </table>
  </details>

  <p class="sutil">Considera só os lançamentos de produção (perdas e ajustes de contagem ficam no extrato do produto).</p>

<%
  // Textos da imagem compartilhada (a imagem precisa fazer sentido sozinha numa conversa)
  const compartilhar = {
    produto: produto.nome,
    subtitulo: `Produção por ${nomeGrao} · últimos ${periodos[periodo].nome} (${u.data(baldes[0].inicio)} a ${u.data(baldes.at(-1).fim)})`,
    numeros: [
      ['Total', qtd(total)],
      ['Média por dia', qtd(mediaDia)],
      [`Melhor ${nomeGrao}`, melhor ? `${qtd(melhor.valor)} (${melhor.detalhe})` : '—'],
    ],
    texto: `${produto.nome}: ${qtd(total)} em ${periodos[periodo].nome} (média de ${qtd(mediaDia)} por dia)`,
    arquivo: `producao-${produto.nome}-${periodo}`.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    rodape: `Eggsystem · gerado em ${u.data(u.hoje())}`,
  };
%>
  <script type="application/json" id="dados-grafico"><%- JSON.stringify({ baldes, escala, maior: melhor && melhor.inicio, compartilhar }).replace(/</g, '\\u003c') %></script>
  <script src="/compartilhar-grafico.js?v=<%= versao %>" defer></script>
  <script>
    (function () {
      const el = document.getElementById('grafico');
      if (!el) return;
      const { baldes, escala, maior } = JSON.parse(document.getElementById('dados-grafico').textContent);
      const NS = 'http://www.w3.org/2000/svg';
      const fmt = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 1 });
      const no = (tag, attrs, pai) => {
        const n = document.createElementNS(NS, tag);
        for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, v);
        if (pai) pai.appendChild(n);
        return n;
      };

      // Tooltip único (HTML, conteúdo via textContent)
      const dica = document.createElement('div');
      dica.className = 'grafico-dica';
      dica.hidden = true;
      const dicaValor = document.createElement('strong');
      const dicaRotulo = document.createElement('span');
      dica.append(dicaValor, dicaRotulo);

      function desenhar() {
        el.replaceChildren();
        const W = el.clientWidth;
        const H = 240;
        const m = { esq: 40, dir: 8, topo: 22, base: 26 };
        const pw = W - m.esq - m.dir;
        const ph = H - m.topo - m.base;
        const y = (v) => m.topo + ph - (v / escala.topo) * ph;
        const svg = no('svg', { width: W, height: H, viewBox: `0 0 ${W} ${H}` }, el);

        // Grade e eixo Y (linhas finas, discretas)
        for (let v = 0; v <= escala.topo + 1e-9; v += escala.passo) {
          no('line', { x1: m.esq, x2: W - m.dir, y1: y(v), y2: y(v), class: 'grade' }, svg);
          const t = no('text', { x: m.esq - 6, y: y(v) + 4, 'text-anchor': 'end', class: 'eixo' }, svg);
          // Número completo até 9.999 (ex.: 1.250); abrevia só daí em diante, sem perder precisão
          t.textContent = v >= 10000 ? new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 2 }).format(v / 1000) + ' mil' : fmt.format(v);
        }

        const banda = pw / baldes.length;
        const largura = Math.max(2, Math.min(24, banda - 2)); // no máximo 24px, com 2px de respiro
        const cadaRotulo = Math.ceil(baldes.length / Math.max(1, Math.floor(pw / 52)));

        baldes.forEach((b, i) => {
          const cx = m.esq + banda * i + banda / 2;
          const x = cx - largura / 2;
          const topo = y(b.valor);
          const base = y(0);
          const g = no('g', { class: 'barra', tabindex: 0, role: 'img' }, svg);
          g.setAttribute('aria-label', `${b.detalhe}: ${b.texto}`);
          // Área de toque: a coluna inteira, maior que a barra
          no('rect', { x: m.esq + banda * i, y: m.topo, width: banda, height: ph, class: 'alvo' }, g);
          if (b.valor > 0) {
            const r = Math.min(4, (base - topo) / 2, largura / 2); // ponta arredondada, base reta
            no('path', {
              class: 'marca',
              d: `M${x},${base} V${topo + r} Q${x},${topo} ${x + r},${topo} H${x + largura - r} Q${x + largura},${topo} ${x + largura},${topo + r} V${base} Z`,
            }, g);
          }
          // Rótulo seletivo: só o maior valor recebe número em cima
          if (b.inicio === maior) {
            const t = no('text', { x: cx, y: topo - 6, 'text-anchor': 'middle', class: 'rotulo-valor' }, svg);
            t.textContent = fmt.format(b.valor);
          }
          const ultimo = i === baldes.length - 1;
          if ((baldes.length - 1 - i) % cadaRotulo === 0 || ultimo) {
            const t = no('text', { x: cx, y: H - 8, 'text-anchor': 'middle', class: 'eixo' }, svg);
            t.textContent = b.rotulo;
          }

          const mostrar = () => {
            dicaValor.textContent = b.texto;
            dicaRotulo.textContent = b.detalhe;
            dica.hidden = false;
            const larguraDica = dica.offsetWidth;
            dica.style.left = Math.min(Math.max(0, cx - larguraDica / 2), W - larguraDica) + 'px';
            dica.style.top = Math.max(0, topo - dica.offsetHeight - 8) + 'px';
            g.classList.add('ativa');
          };
          const esconder = () => { dica.hidden = true; g.classList.remove('ativa'); };
          g.addEventListener('pointerenter', mostrar);
          g.addEventListener('pointerdown', mostrar);
          g.addEventListener('focus', mostrar);
          g.addEventListener('pointerleave', esconder);
          g.addEventListener('blur', esconder);
        });
        el.appendChild(dica);
      }

      desenhar();
      let espera;
      window.addEventListener('resize', () => { clearTimeout(espera); espera = setTimeout(desenhar, 150); });
    })();
  </script>
<% } %>
<%- include('partials/rodape') %>
