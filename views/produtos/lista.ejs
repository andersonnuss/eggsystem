<%- include('../partials/topo') %>
<div class="cabecalho">
  <h1>Produtos</h1>
  <a href="/produtos/novo" class="botao">+ Novo</a>
</div>
<% if (!produtos.length) { %>
  <p class="vazio">Nenhum produto ainda. Comece cadastrando o que o sítio produz.</p>
<% } %>
<ul class="lista">
  <% for (const p of produtos) { %>
    <li class="<%= p.ativo ? '' : 'inativo' %>">
      <a class="bloco" href="/produtos/<%= p.id %>">
        <div class="titulo"><%= p.nome %><%= p.ativo ? '' : ' (inativo)' %></div>
        <div class="sutil"><%= u.dinheiro(p.preco_centavos) %> / <%= p.unidade %><%= p.unidade_producao ? ` · produção em ${p.unidade_producao} (${u.numero(p.fator)} = 1 ${p.unidade})` : '' %></div>
      </a>
      <div class="valor">
        <div><%= u.numero(p.estoque) %> <%= p.unidade %></div>
        <div class="sutil"><%= p.unidade_producao ? `${u.numero(p.estoque_producao)} ${p.unidade_producao}` : 'em estoque' %></div>
      </div>
    </li>
  <% } %>
</ul>
<%- include('../partials/rodape') %>
