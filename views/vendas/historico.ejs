<%- include('../partials/topo') %>
<h1>Histórico de vendas</h1>
<%
  const nomeGrao = { dia: 'dia', semana: 'semana', mes: 'mês' }[grao];
  // Monta uma URL da tela preservando os filtros atuais, trocando só o que vier em `troca`
  const url = (troca = {}) => {
    const q = { produto: produto ? produto.id : '', cliente: cliente ? cliente.id : '', periodo, ...troca };
    for (const k of Object.keys(q)) if (q[k] === '' || q[k] == null) delete q[k];
    return `/vendas/historico?${new URLSearchParams(q)}`;
  };
  const intervalo = `${u.data(baldes[0].inicio)} a ${u.data(baldes.at(-1).fim)}`;
  // Nome do que está sendo mostrado (produto e/ou cliente)
  const partes = [];
  if (produto) partes.push(produto.nome);
  if (cliente) partes.push(cliente.nome);
  const alvo = partes.length ? partes.join(' · ') : 'Todos os produtos';
  const tituloVendas = produto || cliente
    ? `Vendas${produto ? ' de ' + produto.nome : ''}${cliente ? ' — ' + cliente.nome : ''}`
    : 'Vendas';
%>

<form method="get" action="/vendas/historico" class="filtros-grafico">
  <input type="hidden" name="periodo" value="<%= periodo %>">
  <select name="produto" onchange="this.form.submit()" aria-label="Produto">
    <option value="">Todos os produtos</option>
    <% for (const p of produtos) { %>
      <option value="<%= p.id %>" <%= produto && p.id === produto.id ? 'selected' : '' %>><%= p.nome %></option>
    <% } %>
  </select>
  <select name="cliente" onchange="this.form.submit()" aria-label="Cliente">
    <option value="">Todos os clientes</option>
    <% for (const c of clientes) { %>
      <option value="<%= c.id %>" <%= cliente && c.id === cliente.id ? 'selected' : '' %>><%= c.nome %></option>
    <% } %>
  </select>
  <div class="filtros" role="group" aria-label="Período">
    <% for (const [chave, p] of Object.entries(periodos)) { %>
      <a href="<%= url({ periodo: chave }) %>" class="<%= chave === periodo ? 'ativo' : '' %>" <%= chave === periodo ? 'aria-current="true"' : '' %>><%= p.nome %></a>
    <% } %>
  </div>
</form>

<div class="numeros numeros-vendas">
  <div class="numero"><div class="rotulo">Vendido em <%= periodos[periodo].nome %></div>
    <div class="valor"><%= u.dinheiro(total) %></div>
    <% if (comparacao) { %><div class="sutil"><%= comparacao %></div><% } %>
  </div>
  <% if (produto) { %>
    <div class="numero"><div class="rotulo">Quantidade</div>
      <div class="valor"><%= qtd(quantidade) %></div>
      <div class="sutil">em <%= vendas %> venda<%= vendas === 1 ? '' : 's' %></div>
    </div>
  <% } else { %>
    <div class="numero"><div class="rotulo">Vendas</div>
      <div class="valor"><%= vendas %></div>
      <% if (vendas) { %><div class="sutil">média de <%= u.dinheiro(Math.round(total / vendas)) %> por venda</div><% } %>
    </div>
  <% } %>
  <div class="numero"><div class="rotulo">Melhor <%= nomeGrao %></div>
    <div class="valor"><%= melhor ? u.dinheiro(melhor.centavos) : '—' %></div>
    <% if (melhor) { %><div class="sutil"><%= melhor.detalhe %></div><% } %>
  </div>
  <div class="numero <%= aberto > 0 ? 'alerta' : '' %>"><div class="rotulo">Ainda a receber</div>
    <div class="valor"><%= u.dinheiro(aberto) %></div>
    <div class="sutil">das vendas do período</div>
  </div>
</div>

<div class="cartao grafico-cartao">
  <div class="sutil grafico-titulo">
    <%= alvo %>: vendido por <%= nomeGrao %>, em R$ (<%= intervalo %>)
  </div>
  <% if (total === 0) { %>
    <p class="vazio">Nenhuma venda neste período.</p>
  <% } else { %>
    <div id="grafico" class="grafico" role="img"
         aria-label="<%= `${tituloVendas} por ${nomeGrao}, total ${u.dinheiro(total)}` %>"></div>
    <div class="acoes grafico-acoes">
      <button type="button" id="compartilhar" class="botao secundario">📤 Compartilhar</button>
      <span id="compartilhar-aviso" class="sutil" role="status"></span>
    </div>
  <% } %>
</div>

<details class="cartao" <%= total > 0 ? 'open' : '' %>>
  <summary>Por <%= nomeGrao %></summary>
  <table class="tabela">
    <thead><tr>
      <th><%= nomeGrao[0].toUpperCase() + nomeGrao.slice(1) %></th>
      <th class="direita">Vendas</th>
      <% if (produto) { %><th class="direita">Qtd.</th><% } %>
      <th class="direita">Valor</th>
    </tr></thead>
    <tbody>
      <% for (const b of baldes.slice().reverse()) { %>
        <tr>
          <td><%= b.detalhe %></td>
          <td class="direita"><%= b.vendas %></td>
          <% if (produto) { %><td class="direita"><%= u.numero(b.quantidade) %></td><% } %>
          <td class="direita"><%= b.texto %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</details>

<% if (porProduto.length) { %>
  <h2><%= cliente ? `O que ${cliente.nome} mais comprou` : 'O que mais vendeu' %></h2>
  <ul class="lista">
    <% for (const p of porProduto) { %>
      <li>
        <a class="bloco" href="<%= url({ produto: p.id }) %>">
          <div class="titulo"><%= p.nome %></div>
          <div class="sutil"><%= u.numero(p.quantidade) %> <%= p.unidade %> · <%= Math.round((p.centavos / total) * 100) %>% do total</div>
        </a>
        <div class="valor"><%= u.dinheiro(p.centavos) %></div>
      </li>
    <% } %>
  </ul>
<% } %>

<% if (topClientes.length) { %>
  <h2>Quem mais comprou</h2>
  <ul class="lista">
    <% for (const c of topClientes) { %>
      <li>
        <a class="bloco" href="<%= url({ cliente: c.id }) %>">
          <div class="titulo"><%= c.nome %></div>
          <div class="sutil"><%= c.vendas %> compra<%= c.vendas === 1 ? '' : 's' %></div>
        </a>
        <div class="valor"><%= u.dinheiro(c.centavos) %></div>
      </li>
    <% } %>
  </ul>
<% } %>

<p class="sutil">Pela data da venda, pagas ou não. A comparação usa o mesmo número de dias logo antes do período.</p>

<% if (total > 0) {
  // Textos da imagem compartilhada (a imagem precisa fazer sentido sozinha numa conversa)
  const compartilhar = {
    produto: tituloVendas,
    subtitulo: `Por ${nomeGrao} · últimos ${periodos[periodo].nome} (${intervalo})`,
    numeros: [
      ['Total vendido', u.dinheiro(total)],
      produto ? ['Quantidade', qtd(quantidade)] : ['Vendas', String(vendas)],
      [`Melhor ${nomeGrao}`, melhor ? `${u.dinheiro(melhor.centavos)} (${melhor.detalhe})` : '—'],
    ],
    texto: `${tituloVendas}: ${u.dinheiro(total)} em ${periodos[periodo].nome}${comparacao ? ` (${comparacao})` : ''}`,
    arquivo: `vendas-${produto ? produto.nome + '-' : ''}${cliente ? cliente.nome + '-' : ''}${periodo}`.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    rodape: `Eggsystem · gerado em ${u.data(u.hoje())}`,
  };
%>
  <script type="application/json" id="dados-grafico"><%- JSON.stringify({ baldes, escala, maior: melhor && melhor.inicio, prefixo: 'R$ ', compartilhar }).replace(/</g, '\\u003c') %></script>
  <script src="/compartilhar-grafico.js?v=<%= versao %>" defer></script>
  <script src="/grafico-barras.js?v=<%= versao %>" defer></script>
<% } %>
<%- include('../partials/rodape') %>
