<%- include('partials/topo') %>
<div class="cartao estreito">
  <h1>Primeiro acesso</h1>
  <p class="sutil">Crie o usuário que vai acessar o sistema.</p>
  <% if (erro) { %><div class="erro"><%= erro %></div><% } %>
  <form method="post" action="/configurar" class="formulario">
    <label>Usuário <input name="usuario" value="<%= usuario %>" autocomplete="username" autocapitalize="none" required minlength="3" autofocus></label>
    <label>Senha <input name="senha" type="password" autocomplete="new-password" required minlength="8"></label>
    <label>Confirme a senha <input name="confirmacao" type="password" autocomplete="new-password" required minlength="8"></label>
    <button class="botao">Criar e entrar</button>
  </form>
</div>
<%- include('partials/rodape') %>
